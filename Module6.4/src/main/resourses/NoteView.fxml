<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" prefWidth="400" prefHeight="500" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.NoteController">
    <Label text="Title" />
    <TextField fx:id="titleField" />
    <Label text="Note" />
    <TextArea fx:id="contentArea" prefHeight="120" />
    <Button text="Add" onAction="#handleAddNote" />
    <Label text="Saved notes" />
    <TextArea fx:id="notesDisplay" editable="false" />
</VBox>